#!/usr/bin/env bash
# crate's pre-receive: main moves only to a commit whose check passed on the exact tree main becomes. Git refuses the
# whole push when this exits non-zero, and sends what it printed to the pusher. A branch other than main takes no check.
set -euo pipefail
# shellcheck source=lib/crate.sh
. "$(dirname "$(readlink -f "$0")")/../lib/crate.sh"

status=0
while read -r old new ref; do
  [ "$ref" = refs/heads/main ] || continue
  if zero "$new"; then
    echo "crate: main is never deleted" >&2
    status=1
    continue
  fi
  check "$old" "$new" || status=1
done
exit "$status"
