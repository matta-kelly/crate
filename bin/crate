#!/usr/bin/env bash
# crate: the shared CI every repo runs.
#   crate init <bare> [<github url>]
#                       make or take a bare repo, and put crate's hooks and rules on it. With a GitHub url, main is
#                       copied there after each move: an ssh url gets the repo's own deploy key, made here once
#                       (~/.ssh/crate-<repo>), and its public half is printed to add to the GitHub repo
#   crate apply <file|->
#                       make this server match its declaration (KEY=value lines): CRATE_VERSION, the tag this
#                       crate checkout runs; GIT_HOME, where the bare repos live; GITHUB_BASE, the url each repo's
#                       copy goes to, before /<repo>.git; REPOS, the repos. Safe to run again: it checks out the
#                       version, inits each repo, and seeds a new one's main from GitHub
#   crate postsubmit <bare>
#                       run the repo's postsubmit on main as it stands; post-receive starts it. Green releases main,
#                       red reverts the commits since the last green main
set -euo pipefail
root=$(dirname "$(dirname "$(readlink -f "$0")")")

case "${1:-}" in
  init)
    bare=${2:?usage: crate init <bare repo>}
    [ -d "$bare" ] || git init -q --bare -b main "$bare"
    git -C "$bare" config core.hooksPath "$root/hooks"
    git -C "$bare" config receive.denyNonFastForwards true
    git -C "$bare" config receive.denyDeletes true
    mkdir -p "$bare/crate"
    github=${3:-}
    if [ -n "$github" ]; then
      if git -C "$bare" remote get-url github >/dev/null 2>&1; then
        git -C "$bare" remote set-url github "$github"
      else
        git -C "$bare" remote add github "$github"
      fi
      case "$github" in
        git@* | ssh://*)
          key="$HOME/.ssh/crate-$(basename "$bare" .git)"
          mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
          if [ ! -f "$key" ]; then
            ssh-keygen -q -t ed25519 -N "" -C "crate $(basename "$bare" .git)" -f "$key"
            echo "crate: the deploy key to add, with write access: $(cat "$key.pub")"
          fi
          git -C "$bare" config core.sshCommand "ssh -i $key -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
          ;;
      esac
    fi
    if [ ! -d "$bare/crate/work/.git" ]; then
      git init -q "$bare/crate/work"
      echo "$(cd "$bare" && pwd)/objects" >"$bare/crate/work/.git/objects/info/alternates"
    fi
    echo "crate: $bare checks every push to main"
    ;;
  apply)
    from=${2:?usage: crate apply <file|->}
    if [ "$from" = - ]; then conf=$(cat); else conf=$(cat "$from"); fi
    # value <key>: the last KEY=value line for it. The file is read, never sourced.
    value() { sed -n "s/^$1=//p" <<<"$conf" | tail -1 | sed 's/^"\(.*\)"$/\1/'; }
    version=$(value CRATE_VERSION)
    git_home=$(value GIT_HOME)
    git_home=${git_home/#\~/$HOME}
    base=$(value GITHUB_BASE)
    repos=$(value REPOS)
    [ -n "$git_home" ] && [ -n "$base" ] || { echo "crate apply: GIT_HOME and GITHUB_BASE are needed" >&2; exit 2; }
    # This checkout to the declared version first, then the rest by that version's own code.
    if [ -n "$version" ] && [ -z "${CRATE_APPLIED:-}" ]; then
      git -C "$root" fetch -q --tags --force origin
      if [ "$(git -C "$root" rev-parse HEAD)" != "$(git -C "$root" rev-parse "$version^{commit}")" ]; then
        git -C "$root" checkout -q --detach "$version"
        echo "crate: now at $version ($(git -C "$root" rev-parse --short HEAD))"
      fi
      CRATE_APPLIED=1 exec "$root/bin/crate" apply - <<<"$conf"
    fi
    mkdir -p "$git_home"
    status=0
    for repo in $repos; do
      bare="$git_home/$repo.git"
      "$root/bin/crate" init "$bare" "$base/$repo.git" | grep -v 'checks every push' || true
      git -C "$bare" rev-parse -q --verify refs/heads/main >/dev/null && continue
      if git -C "$bare" fetch -q github main:refs/heads/main 2>/dev/null; then
        echo "crate: $repo seeded from GitHub's main ($(git -C "$bare" rev-parse --short main))"
      else
        key="$HOME/.ssh/crate-$repo.pub"
        echo "crate: $repo has no main: GitHub refused the fetch. Add its deploy key, with write access, then apply again${key:+: $(cat "$key" 2>/dev/null)}" >&2
        status=1
      fi
    done
    exit "$status"
    ;;
  postsubmit)
    # Close what it inherited from the hook: git waits for the push until every copy of its pipes is closed.
    for fd in /proc/"$$"/fd/*; do
      fd=${fd##*/}
      if [ "$fd" -gt 2 ]; then eval "exec $fd>&-"; fi
    done
    GIT_DIR=$(cd "${2:?usage: crate postsubmit <bare repo>}" && pwd)
    export GIT_DIR
    # shellcheck source=lib/crate.sh
    . "$root/lib/crate.sh"
    postsubmit
    ;;
  *)
    sed -n '3,14s/^#   //p' "$0" >&2
    exit 2
    ;;
esac
